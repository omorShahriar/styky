<?xml version="1.0" encoding="utf-8"?>
<!--
  Template. scripts/build-msix.ps1 fills in the double-brace tokens.
  Identity Name and Publisher are the real Partner Center values (Product identity page, Store ID 9NZ2ZDFQJLB5).
  They are public package metadata. A -Store build uses them as they are; a local-test build swaps in a test identity.
  PublisherDisplayName is a build parameter (default "omor.dev"): it has to equal the Partner Center account's
  publisher display name when the package is uploaded. See docs/RELEASING.md.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity Name="omor.dev.Styky" Publisher="CN=150ED2D0-F7B0-4A9D-B63F-68D0C7FDD60C" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Styky</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Styky" Executable="styky.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Styky"
        Description="Always-visible work reminders that live on your desktop."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
      </uap:VisualElements>
      <Extensions>
        <!-- Launch at login. Enabled by default; the user can switch it off in Task Manager > Startup apps. -->
        <uap5:Extension Category="windows.startupTask" Executable="styky.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="StykyStartup" Enabled="true" DisplayName="Styky" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
